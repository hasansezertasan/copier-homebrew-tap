{
  // MD013 (line length) is disabled: prose docs (README, ADRs, research notes)
  // wrap at whatever width reads well rather than a fixed column.
  "config": {
    "default": true,
    "MD013": false,
    // MD041 (first line is an h1) is disabled: the pull request template
    // starts at an h2, because GitHub shows the PR title above it.
    "MD041": false,
  },
  "globs": ["**/*.md", "**/*.markdown"],
  "gitignore": true,
}
